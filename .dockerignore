# 4scribe container build context (deny-all allowlist).
# Everything not re-included below is excluded from the image/context.
*
!requirements-container.txt
!src
!src/**
!tests
!tests/**
# Generated caches must never enter the build context, even under src/tests.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Development-only interpreter, static tools and dotenv stay out of the image.
.venv
.dev-tools
.env
.env.*

# Only this public verifier is needed by image-contained mock tests.
!deployment
!deployment/smoke_wss.py
