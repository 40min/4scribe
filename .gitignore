# Default deny: explicitly tracked source/public tooling only.
/*
!/.gitignore
!/README.md
!/src/
!/tests/
!/deployment/
!/docs/
/src/*
!/src/fourscribe/
/tests/*
!/tests/*.py
/deployment/*
!/deployment/smoke_wss.py
!/deployment/compose.yaml
!/deployment/retire-host-runtime.sh
!/deployment/cleanup-residual-scratch.sh
!/deployment/container-acceptance.sh
!/deployment/enhancement-candidate-smoke.sh
!/deployment/diagnostics/
!/deployment/replay/
/deployment/diagnostics/*
!/deployment/diagnostics/*.py
/deployment/replay/*
!/deployment/replay/*.py
/docs/*
!/docs/pip-freeze-2026-10-16-completion.txt
!/docs/container-permanent.md
!/docs/legacy-retirement-plan.md
!/docs/backend-eval-manifest-2026-10-16.md
!/docs/mobile-batch-api.md
!/docs/dev-environment.md
!/docs/container-acceptance.md
!/docs/enhancement-api.md
# Never track generated caches, credentials, model weights or recordings.
**/__pycache__/
*.py[cod]
*.bak
.env
.env.*
*.wav
*.mp3
*.flac
*.safetensors
*.gguf

# Local-only development environment and tools.
/.venv/
/.dev-tools/
/.pytest_cache/

# Local-only harness contains private host routing metadata.
/deployment/diagnostics/diagnose_real_pipeline.py
/tests/test_diag_units.py
